MELI_BASE_URL=https://api.mercadolibre.com
MELI_SITE_ID=MLB
MELI_TIMEOUT_SECONDS=20
MELI_MAX_RETRIES=3
MELI_RATE_LIMIT_SECONDS=0.2
MELI_PUBLIC_QUERIES=notebook,celular,smart tv,geladeira,fone bluetooth,cadeira gamer
MELI_AUTH_BASE_URL=https://auth.mercadolivre.com.br
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=http://localhost:8000/auth/meli/callback
MELI_USE_PKCE=false
MELI_TOKEN_STORE_PATH=data/secrets/meli_oauth_token.json
MELI_TOKEN_ENCRYPTION_KEY=
MELI_ENABLE_AUTHENTICATED_COLLECTION=false
DATA_DIR=data
LOG_LEVEL=INFO
DUCKDB_PATH=data/warehouse/mercado_intelligence.duckdb
POSTGRES_DSN=postgresql+psycopg://postgres:postgres@localhost:5432/mercado_intelligence
